---
// Tokens du design system (couche 1) — source unique, générée depuis design/tokens.json.
// Ne pas redéfinir de custom properties ici : éditer design/tokens.json puis régénérer l'adapter.
import '../../design/adapters/tokens.css';

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Outils interactifs pour le jeu de rôle narratif, pour joueuses et joueurs solo comme pour les meneuses et meneurs de jeu.',
} = Astro.props;

const REPO_URL = 'https://github.com/RebelliousSmile/choix-narratifs';

const navItems = [
  { href: '/', label: 'Concept' },
  { href: '/documentation', label: 'Documentation' },
  { href: '/articles', label: 'Articles' },
  { href: '/elaboration', label: 'Moteur' },
  { href: REPO_URL, label: 'Code', external: true },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

// Pages d'usage du moteur narratif : l'entrée de nav « Moteur » reste active sur toutes.
const moteurPaths = ['/elaboration', '/moteur-narratif', '/compte-rendu'];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/">Choix narratifs</a>
        <nav class="site-nav" aria-label="Navigation principale">
          <ul>
            {
              navItems.map((item) => {
                if (item.external) {
                  return (
                    <li>
                      <a
                        href={item.href}
                        class="site-nav__external"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {item.label}
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    </li>
                  );
                }
                const itemPath = item.href.replace(/\/+$/, '') || '/';
                const isCurrent =
                  itemPath === currentPath ||
                  (itemPath === '/elaboration' && moteurPaths.includes(currentPath));
                return (
                  <li>
                    <a href={item.href} aria-current={isCurrent ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenu" class="container site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p class="site-footer__copy">
          &copy; <a href="https://fxguillois.fr" target="_blank" rel="noopener noreferrer">François-Xavier Guillois</a> 2026
        </p>
        <nav class="site-footer__legal" aria-label="Mentions légales">
          <a href="/mentions-legales">Mentions légales</a>
          <a href="/cgu">CGU</a>
        </nav>
      </div>
    </footer>

    <style is:global>
      /* Les tokens (:root) sont fournis par design/adapters/tokens.css (importé dans le frontmatter). */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        color-scheme: dark;
      }

      body {
        margin: 0;
        background: var(--color-semantic-background);
        color: var(--color-semantic-text);
        font-family: var(--font-family-sans);
        font-size: var(--font-size-base);
        line-height: var(--font-line-height-base);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .container {
        width: 100%;
        max-width: var(--size-container-default);
        margin-inline: auto;
        padding-inline: var(--space-3);
      }

      a {
        color: var(--color-semantic-accent-strong);
      }

      :focus-visible {
        outline: 3px solid var(--color-semantic-focus);
        outline-offset: 2px;
        border-radius: var(--radius-sm);
      }

      .skip-link {
        position: absolute;
        left: var(--space-2);
        top: -3rem;
        background: var(--color-semantic-accent);
        color: #fff;
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-sm);
        z-index: 10;
        transition: top 0.15s ease;
      }

      .skip-link:focus {
        top: var(--space-2);
      }

      .site-header {
        border-bottom: 1px solid var(--color-semantic-border);
        background: var(--color-semantic-surface);
      }

      .site-header__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        padding-block: var(--space-3);
      }

      .brand {
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--color-semantic-text);
        text-decoration: none;
      }

      .site-nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1) var(--space-3);
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .site-nav a {
        color: var(--color-semantic-text-muted);
        text-decoration: none;
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-sm);
      }

      .site-nav a:hover {
        color: var(--color-semantic-text);
        background: var(--color-semantic-surface-raised);
      }

      .site-nav a[aria-current='page'] {
        color: var(--color-semantic-accent-strong);
        font-weight: 600;
      }

      .site-nav__external {
        white-space: nowrap;
      }

      .site-main {
        flex: 1 0 auto;
        padding-block: var(--space-5);
      }

      .site-footer {
        border-top: 1px solid var(--color-semantic-border);
        background: var(--color-semantic-surface);
        color: var(--color-semantic-text-muted);
        padding-block: var(--space-4);
        font-size: 0.9rem;
      }

      .site-footer__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2) var(--space-3);
      }

      .site-footer__copy {
        margin: 0;
      }

      .site-footer__legal {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1) var(--space-3);
      }

      h1,
      h2,
      h3 {
        line-height: 1.2;
      }

      @media (min-width: 48rem) {
        .site-header__inner {
          flex-wrap: nowrap;
        }
      }
    </style>
  </body>
</html>
