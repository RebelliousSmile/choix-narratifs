{
  "$description": "Choix narratifs — tokens FIGÉS (adjust v1.0.0). Territoire éditorial dramatique, deux registres (éditorial serif / applicatif linéale+mono). Dark-only. Source de vérité des valeurs — les adapters en dérivent.",
  "color": {
    "brand": {
      "primary": { "$type": "color", "$value": "#c45a92", "$description": "accent rose magenta (liens, CTA, focus texte)" },
      "primary-strong": { "$type": "color", "$value": "#e07bb0", "$description": "accent survolé / actif" }
    },
    "neutral": {
      "50": { "$type": "color", "$value": "#ece8f5", "$description": "texte principal" },
      "300": { "$type": "color", "$value": "#b3a9c7", "$description": "texte atténué" },
      "600": { "$type": "color", "$value": "#3a3150", "$description": "bordures" },
      "700": { "$type": "color", "$value": "#261f35", "$description": "surface surélevée (panneaux)" },
      "800": { "$type": "color", "$value": "#1e1929", "$description": "surface (header, footer, cartes)" },
      "850": { "$type": "color", "$value": "#191320", "$description": "surface encaissée (fonds de saisie, puits)" },
      "900": { "$type": "color", "$value": "#14111c", "$description": "fond de page" }
    },
    "accent": {
      "gold": { "$type": "color", "$value": "#ffd34d", "$description": "anneau de focus / avertissement" }
    },
    "state": {
      "danger": { "$type": "color", "$value": "#e5484d" },
      "success": { "$type": "color", "$value": "#4fb477" },
      "info": { "$type": "color", "$value": "#7c8cf0" }
    },
    "semantic": {
      "background": { "$type": "color", "$value": "{color.neutral.900}" },
      "surface": { "$type": "color", "$value": "{color.neutral.800}" },
      "surface-raised": { "$type": "color", "$value": "{color.neutral.700}" },
      "surface-sunken": { "$type": "color", "$value": "{color.neutral.850}" },
      "border": { "$type": "color", "$value": "{color.neutral.600}" },
      "text": { "$type": "color", "$value": "{color.neutral.50}" },
      "text-muted": { "$type": "color", "$value": "{color.neutral.300}" },
      "accent": { "$type": "color", "$value": "{color.brand.primary}" },
      "accent-strong": { "$type": "color", "$value": "{color.brand.primary-strong}" },
      "focus": { "$type": "color", "$value": "{color.accent.gold}" },
      "danger": { "$type": "color", "$value": "{color.state.danger}" },
      "success": { "$type": "color", "$value": "{color.state.success}" },
      "warning": { "$type": "color", "$value": "{color.accent.gold}" },
      "info": { "$type": "color", "$value": "{color.state.info}" }
    }
  },
  "font": {
    "family": {
      "serif": { "$type": "fontFamily", "$value": ["Spectral", "Georgia", "Cambria", "Times New Roman", "serif"], "$description": "registre éditorial — titres vitrine, auto-hébergée woff2, titres uniquement" },
      "sans": { "$type": "fontFamily", "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$description": "corps + toute l'UI (les deux registres)" },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$description": "registre applicatif — lectures machine (IDs d'événements, seeds), blocs <pre>" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem", "$description": "eyebrow, caption, badge" },
      "sm": { "$type": "dimension", "$value": "0.875rem", "$description": "méta, UI dense" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "md": { "$type": "dimension", "$value": "1.125rem", "$description": "chapô / lead" },
      "lg": { "$type": "dimension", "$value": "1.375rem", "$description": "h3" },
      "xl": { "$type": "dimension", "$value": "clamp(1.625rem, 3vw, 1.875rem)", "$description": "h2 (serif vitrine)" },
      "2xl": { "$type": "dimension", "$value": "clamp(2rem, 4vw, 2.75rem)", "$description": "h1 (serif vitrine)" },
      "display": { "$type": "dimension", "$value": "clamp(2.75rem, 5vw, 3.75rem)", "$description": "hero (serif vitrine)" }
    },
    "line-height": {
      "tight": { "$type": "number", "$value": 1.15, "$description": "display" },
      "snug": { "$type": "number", "$value": 1.25, "$description": "titres" },
      "base": { "$type": "number", "$value": 1.6 },
      "prose": { "$type": "number", "$value": 1.7, "$description": "corps d'article" }
    },
    "letter-spacing": {
      "eyebrow": { "$type": "dimension", "$value": "0.12em", "$description": "sur-titres / labels" },
      "normal": { "$type": "dimension", "$value": "0" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "1rem" },
    "4": { "$type": "dimension", "$value": "1.5rem" },
    "5": { "$type": "dimension", "$value": "2.5rem" },
    "6": { "$type": "dimension", "$value": "4rem" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0" },
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "full": { "$type": "dimension", "$value": "999px", "$description": "puces, status-dot, pills" }
  },
  "border": {
    "width": {
      "default": { "$type": "dimension", "$value": "1px" },
      "thick": { "$type": "dimension", "$value": "3px", "$description": "anneau de focus, filet de citation, marqueur de registre applicatif" }
    }
  },
  "shadow": {
    "overlay": { "$type": "shadow", "$value": { "color": "#00000066", "offsetX": "0", "offsetY": "8px", "blur": "24px", "spread": "0" }, "$description": "SEULE ombre du système — couches flottantes détachées (toast, dropdown). Le reste est plat." }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms" },
      "base": { "$type": "duration", "$value": "200ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.25, 0.1, 0.25, 1], "$description": "mot-clé CSS 'ease'" }
    }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "640px", "$description": "40rem — min-width" },
    "md": { "$type": "dimension", "$value": "768px", "$description": "48rem — min-width, header en ligne" },
    "lg": { "$type": "dimension", "$value": "1024px", "$description": "64rem — min-width, app-shell multi-colonnes" }
  },
  "size": {
    "container": {
      "prose": { "$type": "dimension", "$value": "44rem", "$description": "largeur de lecture (articles, légal)" },
      "default": { "$type": "dimension", "$value": "64rem", "$description": "chrome vitrine" },
      "wide": { "$type": "dimension", "$value": "80rem", "$description": "workspace applicatif" }
    },
    "touch": {
      "min": { "$type": "dimension", "$value": "44px", "$description": "cible tactile minimale (WCAG)" }
    }
  },
  "icon": {
    "size": {
      "sm": { "$type": "dimension", "$value": "1rem" },
      "md": { "$type": "dimension", "$value": "1.25rem" },
      "lg": { "$type": "dimension", "$value": "1.5rem" }
    },
    "stroke": {
      "default": { "$type": "dimension", "$value": "2", "$description": "trait Lucide natif" },
      "fine": { "$type": "dimension", "$value": "1.5", "$description": "contexte dense / raffiné" }
    }
  },
  "z-index": {
    "base": { "$type": "number", "$value": 0 },
    "dropdown": { "$type": "number", "$value": 1000 },
    "sticky": { "$type": "number", "$value": 1100 },
    "overlay": { "$type": "number", "$value": 1200 },
    "modal": { "$type": "number", "$value": 1300 },
    "toast": { "$type": "number", "$value": 1400 },
    "skip-link": { "$type": "number", "$value": 1600 }
  }
}
